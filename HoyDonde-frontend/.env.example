# Copiá este archivo a ".env" (en esta misma carpeta) y completá los valores
# reales de tu proyecto Firebase. Nunca copies acá la cuenta de servicio del
# backend (HoyDonde.API/firebase-service-account.json): estos valores son
# públicos por diseño (SDK cliente de Firebase), pero la cuenta de servicio no.

# --- API de HoyDonde? ---
# URL base de la API, incluyendo /api. Sin esta variable, en desarrollo se usa
# un fallback local automático (10.0.2.2 para emulador Android, localhost para
# web/iOS); fuera de desarrollo es obligatoria.
#
# Para probar desde un dispositivo físico en la misma red Wi-Fi que tu backend,
# usá la IP LAN de tu máquina en vez de localhost, por ejemplo:
#   EXPO_PUBLIC_API_URL=http://192.168.1.50:5053/api
EXPO_PUBLIC_API_URL=http://localhost:5053/api

# --- Firebase (valores públicos del SDK cliente, panel de Firebase > Configuración del proyecto) ---
EXPO_PUBLIC_FIREBASE_API_KEY=AIzaSyExampleExampleExampleExampleExx
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=hoydonde-app.firebaseapp.com
EXPO_PUBLIC_FIREBASE_PROJECT_ID=hoydonde-app
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=hoydonde-app.appspot.com
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=123456789012
EXPO_PUBLIC_FIREBASE_APP_ID=1:123456789012:web:abcdef1234567890abcdef
